    <!-- Help & FAQ -->
    <string name="help_title">Help &amp; Transparency</string>
    <string name="help_subtitle">Understanding Android media recovery and privacy</string>
    <string name="faq_storage_title">Can permanently purged files be recovered?</string>
    <string name="faq_storage_desc">On Android 10 and newer, device storage uses File-Based Encryption (FBE) and flash memory TRIM commands. When a file is permanently erased and blocks are reclaimed, the raw sectors are zeroed and cryptographic keys destroyed. Without root access, low-level disk carving of purged blocks is mathematically and physically impossible. Anyone claiming otherwise is misleading you.</string>
    <string name="faq_recoverable_title">What does Assets Recovery safely find?</string>
    <string name="faq_recoverable_desc">1) MediaStore Recycle Bin: Photos and videos recently deleted in Gallery apps that remain preserved for up to 30 days.\n\n2) Hidden &amp; Orphaned Media: Photos and videos located in .nomedia folders, app caches (WhatsApp, Telegram, status caches), and unindexed subdirectories.\n\n3) Inaccessible Files: Media with broken extensions or corrupted headers that can be rescued and restored.</string>
    <string name="faq_privacy_title">Is my personal media private?</string>
    <string name="faq_privacy_desc">Yes, 100%. Assets Recovery processes all file operations completely on your device. We do not operate remote servers, collect analytics, or upload any personal files.</string>
    <string name="faq_destination_title">Where are recovered files saved?</string>
    <string name="faq_destination_desc">Files are restored directly to your public Pictures/RecoveredMedia or DCIM/RecoveredMedia library, making them immediately visible in Google Photos and your device Gallery.</string>

